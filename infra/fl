#!/usr/bin/env bash
# The EC2 recorder, driven from the laptop. Run from anywhere in the repo: infra/fl <command>
#
#   up         create (or find) the instance, its SSH key, firewall and fixed IP; needs `aws login`
#   allow-ip   let this network's IP reach SSH (after changing Wi-Fi); lists the other IPs still allowed
#   forget-ip IP  stop allowing an IP you no longer use
#   install    copy the code, .env and secrets/, then set up Python and systemd on the server
#   cutover    stop the laptop's recorders, hand the open hour to the server, start the recorders there
#   deploy     copy code changes and restart the server's recorders, one at a time
#   sync-code  copy code changes without restarting (recorder changes apply at the next restart)
#   status     tape.ctl status on the server
#   logs NAME  follow one recorder's log on the server
#   pull       copy the server's finished tape hours (tape/manifest.py) and recorder logs into data/
#   report     the recorders' state on the server, as JSON
#              (the `pull` service in tape.ctl runs report every minute and pull every 10 minutes)
#   ssh        a shell on the server
#
# The server runs the recorders only; the board and tracker run on the laptop over the pulled tape.
# Everything is found by the Name tag fairline-recorder. The SSH key is ~/.ssh/fairline.pem and the
# host entry is infra/ssh_config (git-ignored), so ssh/rsync work without an AWS session.
set -euo pipefail
cd "$(dirname "$0")/.."

NAME=fairline-recorder
REGION=${AWS_REGION:-us-east-1}
TYPE=${FAIRLINE_INSTANCE_TYPE:-t4g.micro}
DISK_GB=60  # grown from 20 on 2026-10-29: about 3 GB of tape a week
KEY="$HOME/.ssh/fairline.pem"
SSHCFG=infra/ssh_config
RECORDERS="kalshi-live kalshi-backup odds"
AMI_PARAM=/aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id

aws_() { aws --region "$REGION" "$@"; }
ssh_() { ssh -F "$SSHCFG" -o ConnectTimeout=15 fairline "$@"; }
rsync_() { rsync -az -e "ssh -F $SSHCFG -o ConnectTimeout=15" "$@"; }
units() { for n in "$@"; do printf 'fairline@%s ' "$n"; done; }

need_aws() {
  aws_ sts get-caller-identity >/dev/null 2>&1 || { echo "Not signed in to AWS. Run: aws login"; exit 1; }
}

need_host() {
  [ -f "$SSHCFG" ] || { echo "No server yet. Run: infra/fl up"; exit 1; }
}

# Prints the group id, or an error line starting "error:" (bash 3.2 does not apply set -e inside $(...),
# so callers check the result with sg_or_die).
security_group() {
  local vpc sg
  vpc=$(aws_ ec2 describe-vpcs --filters Name=is-default,Values=true --query 'Vpcs[0].VpcId' --output text)
  [ "$vpc" != None ] || { echo "error: this region has no default VPC; set AWS_REGION to one that does."; return 1; }
  sg=$(aws_ ec2 describe-security-groups --filters Name=group-name,Values=fairline-ssh Name=vpc-id,Values="$vpc" \
    --query 'SecurityGroups[0].GroupId' --output text)
  if [ "$sg" = None ]; then
    sg=$(aws_ ec2 create-security-group --group-name fairline-ssh --vpc-id "$vpc" \
      --description "SSH to the fairline recorder from allowed IPs" --query GroupId --output text)
  fi
  echo "$sg"
}

sg_or_die() {
  local sg
  sg=$(security_group) || { echo "${sg#error: }"; exit 1; }
  case "$sg" in sg-*) echo "$sg" ;; *) echo "unexpected security group: $sg"; exit 1 ;; esac
}

ssh_cidrs() {
  aws_ ec2 describe-security-groups --group-ids "$1" \
    --query "SecurityGroups[0].IpPermissions[?FromPort==\`22\`].IpRanges[].CidrIp" --output text | tr '\t' '\n' | grep . || true
}

allow_ip() {
  need_aws
  local sg ip others
  sg=$(sg_or_die) || exit 1
  ip=$(curl -fsS https://checkip.amazonaws.com)
  if ssh_cidrs "$sg" | grep -qx "$ip/32"; then
    echo "SSH already open to $ip"
  else
    aws_ ec2 authorize-security-group-ingress --group-id "$sg" --protocol tcp --port 22 --cidr "$ip/32" >/dev/null
    echo "SSH opened to $ip"
  fi
  others=$(ssh_cidrs "$sg" | grep -vx "$ip/32" || true)
  [ -z "$others" ] || echo "also allowed (infra/fl forget-ip IP to remove one): $(echo $others)"
}

forget_ip() {
  need_aws
  local sg
  sg=$(sg_or_die) || exit 1
  aws_ ec2 revoke-security-group-ingress --group-id "$sg" --protocol tcp --port 22 --cidr "${1%/32}/32" >/dev/null
  echo "SSH closed to ${1%/32}"
}

instance_id() {
  aws_ ec2 describe-instances --filters "Name=tag:Name,Values=$NAME" Name=instance-state-name,Values=pending,running,stopping,stopped \
    --query 'Reservations[].Instances[].InstanceId' --output text
}

up() {
  need_aws
  if ! aws_ ec2 describe-key-pairs --key-names fairline >/dev/null 2>&1; then
    [ ! -f "$KEY" ] || { echo "$KEY exists but AWS has no key pair 'fairline'. Move the file aside first."; exit 1; }
    mkdir -p "$(dirname "$KEY")" && chmod 700 "$(dirname "$KEY")"
    aws_ ec2 create-key-pair --key-name fairline --key-type ed25519 --query KeyMaterial --output text > "$KEY"
    chmod 600 "$KEY"
    echo "SSH key saved to $KEY"
  fi
  [ -f "$KEY" ] || { echo "AWS has key pair 'fairline' but $KEY is missing."; exit 1; }

  local sg id ami root eip ip state
  sg=$(sg_or_die) || exit 1
  allow_ip
  id=$(instance_id)
  if [ -z "$id" ]; then
    ami=$(aws_ ssm get-parameter --name "$AMI_PARAM" --query Parameter.Value --output text)
    root=$(aws_ ec2 describe-images --image-ids "$ami" --query 'Images[0].RootDeviceName' --output text)
    # The disk outlives the instance (DeleteOnTermination=false) and the instance can't be terminated
    # by accident: the tape is the asset.
    id=$(aws_ ec2 run-instances --image-id "$ami" --instance-type "$TYPE" --key-name fairline \
      --security-group-ids "$sg" --disable-api-termination --metadata-options HttpTokens=required \
      --block-device-mappings "DeviceName=$root,Ebs={VolumeSize=$DISK_GB,VolumeType=gp3,Encrypted=true,DeleteOnTermination=false}" \
      --tag-specifications "ResourceType=instance,Tags=[{Key=Name,Value=$NAME}]" "ResourceType=volume,Tags=[{Key=Name,Value=$NAME}]" \
      --query 'Instances[0].InstanceId' --output text)
    echo "launched $id ($TYPE, $DISK_GB GB, $REGION)"
  fi
  state=$(aws_ ec2 describe-instances --instance-ids "$id" --query 'Reservations[0].Instances[0].State.Name' --output text)
  case "$state" in
    stopping) aws_ ec2 wait instance-stopped --instance-ids "$id"; aws_ ec2 start-instances --instance-ids "$id" >/dev/null ;;
    stopped) aws_ ec2 start-instances --instance-ids "$id" >/dev/null; echo "started $id" ;;
  esac
  aws_ ec2 wait instance-running --instance-ids "$id"

  eip=$(aws_ ec2 describe-addresses --filters "Name=tag:Name,Values=$NAME" --query 'Addresses[0].AllocationId' --output text)
  if [ "$eip" = None ]; then
    eip=$(aws_ ec2 allocate-address --domain vpc --tag-specifications "ResourceType=elastic-ip,Tags=[{Key=Name,Value=$NAME}]" \
      --query AllocationId --output text)
  fi
  aws_ ec2 associate-address --instance-id "$id" --allocation-id "$eip" >/dev/null
  ip=$(aws_ ec2 describe-addresses --allocation-ids "$eip" --query 'Addresses[0].PublicIp' --output text)

  cat > "$SSHCFG" <<EOF
Host fairline
  HostName $ip
  User ubuntu
  IdentityFile $KEY
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  UserKnownHostsFile ~/.ssh/known_hosts_fairline
  ServerAliveInterval 30
EOF
  printf 'waiting for SSH on %s' "$ip"
  for _ in $(seq 60); do
    ssh_ true 2>/dev/null && { echo " ready: $id at $ip"; return; }
    printf .; sleep 5
  done
  echo; echo "SSH didn't answer. Try: infra/fl allow-ip"; exit 1
}

# The server gets the code (files deleted but not yet committed are skipped) and only the secrets the
# recorders use: the Kalshi production key and the Odds API key, never the rest of .env or secrets/.
push_code() {
  local pem
  ssh_ 'mkdir -p ~/fairline/secrets && chmod 700 ~/fairline/secrets'
  git ls-files -co --exclude-standard | while IFS= read -r f; do [ -e "$f" ] && printf '%s\n' "$f"; done \
    | rsync_ --files-from=- ./ fairline:fairline/
  grep -E '^(KALSHI_PROD_|ODDS_API_KEY=|FAIRLINE_)' .env | ssh_ 'umask 077; cat > ~/fairline/.env'
  pem=$(grep -E '^KALSHI_PROD_PRIVATE_KEY_PATH=' .env | cut -d= -f2- | tr -d "\"'")
  rsync_ "$pem" fairline:fairline/secrets/
  ssh_ 'chmod 700 ~/fairline/secrets && chmod 600 ~/fairline/.env ~/fairline/secrets/*'
}

install() {
  need_host
  push_code
  ssh_ 'bash ~/fairline/infra/setup.sh'
}

cutover() {
  need_host
  echo "== stopping the laptop's recorders"
  .venv/bin/python -m tape.ctl stop $RECORDERS
  # The hour each recorder was writing carries on in the same file on the server. Send it up, then set
  # the laptop's partial copy aside so the complete hour comes back down once it closes.
  local open aside f
  open=$(find data/raw -name '*.jsonl' -mmin -15)
  aside="data/run/cutover-$(date +%Y%m%d-%H%M)"
  echo "== sending the open hour files and recorder logs"
  [ -z "$open" ] || echo "$open" | rsync_ --files-from=- ./ fairline:fairline/
  rsync_ data/logs/kalshi-live.log data/logs/kalshi-backup.log data/logs/odds.log fairline:fairline/data/logs/
  echo "== starting the recorders on the server"
  ssh_ "sudo systemctl enable --now $(units $RECORDERS)"
  for f in $open; do mkdir -p "$aside/$(dirname "$f")"; mv "$f" "$aside/$f"; done
  echo "== restarting the board here and starting pull"
  .venv/bin/python -m tape.ctl restart board
  .venv/bin/python -m tape.ctl start pull
  sleep 10
  status
}

# Restarts the recorders one at a time, so the live and backup Kalshi recorders are never both down.
deploy() {
  need_host
  push_code
  ssh_ "cd ~/fairline && .venv/bin/pip install -q -e . && sudo install -m 644 infra/fairline@.service /etc/systemd/system/ \
    && sudo systemctl daemon-reload"
  for r in $RECORDERS; do
    ssh_ "sudo systemctl try-restart fairline@$r"
    sleep 5
  done
  status
}

# Copies code and the unit file without restarting anything: new recorder code takes effect at the next
# restart. Used when a change matters only to the laptop or to tools run on the server.
sync_code() {
  need_host
  push_code
  ssh_ "cd ~/fairline && .venv/bin/pip install -q -e . && sudo install -m 644 infra/fairline@.service /etc/systemd/system/ \
    && sudo systemctl daemon-reload"
}

status() { need_host; ssh_ "cd ~/fairline && .venv/bin/python -m tape.ctl status $RECORDERS"; }

# The server says which tape files are finished and how far every Kalshi stream is complete
# (tape/manifest.py); only those files come down, and the frontier is recorded after they have, for the
# board's indexer (board/indexer.py). A file still being written or compressed never leaves the server.
pull() {
  need_host
  local manifest
  manifest=$(ssh_ 'cd ~/fairline && .venv/bin/python -m tape.manifest')
  printf '%s' "$manifest" | .venv/bin/python -c 'import json, sys; print("\n".join(json.load(sys.stdin)["files"]))' \
    > data/run/pull-files.txt
  rsync_ --files-from=data/run/pull-files.txt fairline:fairline/ ./
  rsync_ --include 'kalshi-*.log' --include 'odds.log' --exclude '*' fairline:fairline/data/logs/ data/logs/
  printf '%s' "$manifest" | .venv/bin/python -c 'import json, sys; d = json.load(sys.stdin); print(json.dumps({"frontier_ms": d["frontier_ms"], "server_now_ms": d["now_ms"]}))' \
    > data/run/tape-frontier.json.tmp
  mv data/run/tape-frontier.json.tmp data/run/tape-frontier.json
}

case "${1:-}" in
  up) up ;;
  allow-ip) allow_ip ;;
  forget-ip) forget_ip "${2:?which IP?}" ;;
  install) install ;;
  cutover) cutover ;;
  deploy) deploy ;;
  sync-code) sync_code ;;
  status) status ;;
  logs) need_host; ssh_ -t "cd ~/fairline && .venv/bin/python -m tape.ctl logs ${2:?which service?}" ;;
  pull) pull ;;
  report) need_host; ssh_ 'cd ~/fairline && .venv/bin/python -m board.tracker report' ;;
  ssh) need_host; ssh -F "$SSHCFG" fairline ;;
  *) sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
