# One unit per service: fairline@kalshi-live, fairline@kalshi-backup, fairline@odds, fairline@board,
# fairline@board-web. Installed by infra/setup.sh. Restarts anything that exits, and starts on boot.
[Unit]
Description=fairline %i
After=network-online.target time-sync.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/fairline
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/fairline/.venv/bin/python -m tape.ctl run %i
StandardOutput=append:/home/ubuntu/fairline/data/logs/%i.log
StandardError=inherit
# SIGINT, not SIGTERM: the recorders handle it as KeyboardInterrupt and close their tape files, so the
# last second of buffered records is written and the hour can be compressed.
KillSignal=SIGINT
TimeoutStopSec=15
Restart=always
RestartSec=5
# Back off when a recorder keeps failing (a full disk, a revoked key): 5 s, then longer, up to 15 min,
# instead of retrying every 5 s forever and spending three Odds API credits on every attempt.
RestartSteps=6
RestartMaxDelaySec=15min

[Install]
WantedBy=multi-user.target
