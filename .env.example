# Copy to .env (git-ignored) and fill in. Never commit real values.

# Kalshi production key: API Key ID + path to the private key you downloaded.
KALSHI_PROD_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=secrets/kalshi-prod.pem

# Kalshi demo key (separate account at demo.kalshi.co; keys are not shared between environments).
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=secrets/kalshi-demo.pem

# The Odds API (the-odds-api.com). Free tier: 500 credits/month. $59 plan: 100K.
ODDS_API_KEY=

# Optional: where raw tape files go (default: ./data, git-ignored).
# FAIRLINE_DATA_DIR=/path/to/data
